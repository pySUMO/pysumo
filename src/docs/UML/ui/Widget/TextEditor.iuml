class TextEditor {
	__init__(mainwindow)
	setTextChanged()
	_initNumberBar()
	_updateOntologySelector()
	_hideLines(lines)
	_showLines(lines)
	_zoomOut_()
	_zoomIn_()
	showOtherOntology(ontologyname)
	expandIfBracketRemoved()
	increaseSize()
	decreaseSize()
	expandAll()
	hideAll()
	getLayoutWidget()
	numberbarPaint(number_bar, event)
	initAutocomplete()
	searchCompletion()
	toggleVisibility(line)
	hideFrom(line)
	insertCompletion(completion)
	commit()
}
